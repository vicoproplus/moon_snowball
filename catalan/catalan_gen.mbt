///|
let a_4 : Array[@rt.Among] = [
  @rt.Among::new("a", -1, 1),
  @rt.Among::new("e", -1, 1),
  @rt.Among::new("i", -1, 1),
  @rt.Among::new("ïn", -1, 1),

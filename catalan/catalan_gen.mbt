  @rt.Among::new("ï", -1, 1),
  @rt.Among::new("ó", -1, 1),
]

///|
fn r_mark_regions(p : Catalan) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  p.i_p1 = e.limit
  p.i_p2 = e.limit
  v_1 = e.cursor
  try {
    if !@rt.go_out_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    if !@rt.go_in_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.i_p1 = e.cursor
    if !@rt.go_out_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    if !@rt.go_in_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.i_p2 = e.cursor
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_1
  return true
}

///|
fn r_cleaning(p : Catalan) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut among_var : Int32 = 0
  while true {
    v_1 = e.cursor
    try {
      e.bra = e.cursor
      among_var = @rt.find_among(e, a_0)
      e.ket = e.cursor
      if among_var == 1 {
        @rt.slice_from(e, "a")
      } else if among_var == 2 {
        @rt.slice_from(e, "e")
      } else if among_var == 3 {
        @rt.slice_from(e, "i")
      } else if among_var == 4 {
        @rt.slice_from(e, "o")
      } else if among_var == 5 {
        @rt.slice_from(e, "u")
      } else if among_var == 6 {
        @rt.slice_from(e, ".")
      } else {
        if e.cursor >= e.limit {
          raise @rt.Lab0
        }
        e.cursor += 1
      }
      continue
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = v_1
    break
  }
  return true
}

///|
fn r_R1(p : Catalan) -> Bool {
  let e = p.e
  return p.i_p1 <= e.cursor
}

///|
fn r_R2(p : Catalan) -> Bool {
  let e = p.e
  return p.i_p2 <= e.cursor
}

///|
fn r_attached_pronoun(p : Catalan) -> Bool {
  let e = p.e
  e.ket = e.cursor
  if @rt.find_among_b(e, a_1) == 0 {
    return false
  }
  e.bra = e.cursor
  if !r_R1(p) {
    return false
  }
  @rt.slice_del(e)
  return true
}

///|
fn r_standard_suffix(p : Catalan) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_2)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    if !r_R1(p) {
      return false
    }
    @rt.slice_del(e)
  } else if among_var == 2 {
    if !r_R2(p) {
      return false
    }
    @rt.slice_del(e)
  } else if among_var == 3 {
    if !r_R2(p) {
      return false
    }
    @rt.slice_from(e, "log")
  } else if among_var == 4 {
    if !r_R2(p) {
      return false
    }
    @rt.slice_from(e, "ic")
  } else {
    if !r_R1(p) {
      return false
    }
    @rt.slice_from(e, "c")
  }
  return true
}

///|
fn r_verb_suffix(p : Catalan) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_3)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    if !r_R1(p) {
      return false
    }
    @rt.slice_del(e)
  } else {
    if !r_R2(p) {
      return false
    }
    @rt.slice_del(e)
  }
  return true
}

///|
fn r_residual_suffix(p : Catalan) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_4)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    if !r_R1(p) {
      return false
    }
    @rt.slice_del(e)
  } else {
    if !r_R1(p) {
      return false
    }
    @rt.slice_from(e, "ic")
  }
  return true
}

///|
fn stem_inner(p : Catalan) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_5 : Int32 = 0
  let mut v_3 : Int32 = 0
  let _ = r_mark_regions(p)
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_1 = e.limit - e.cursor
  let _ = r_attached_pronoun(p)
  e.cursor = e.limit - v_1
  v_2 = e.limit - e.cursor
  try {
    while true {
      v_3 = e.limit - e.cursor
      try {
        if !r_standard_suffix(p) {
          raise @rt.Lab1
        }
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_3
      if !r_verb_suffix(p) {
        raise @rt.Lab0
      }
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_2
  v_4 = e.limit - e.cursor
  let _ = r_residual_suffix(p)
  e.cursor = e.limit - v_4
  e.cursor = e.limit_backward
  v_5 = e.cursor
  let _ = r_cleaning(p)
  e.cursor = v_5
  return true
}

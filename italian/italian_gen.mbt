              e.cursor = e.limit - v_19
              raise @rt.Lab2
            }
            @rt.slice_del(e)
            e.ket = e.cursor
            if !@rt.eq_s_b(e, "ic") {
              e.cursor = e.limit - v_19
              raise @rt.Lab2
            }
            e.bra = e.cursor
            if i_p2 > e.cursor {
              e.cursor = e.limit - v_19
              raise @rt.Lab2
            }
            @rt.slice_del(e)
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
        }
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_15
      if e.cursor < i_pV {
        raise @rt.Lab0
      }
      v_21 = e.limit_backward
      e.limit_backward = i_pV
      e.ket = e.cursor
      if @rt.find_among_b(e, a_8) == 0 {
        e.limit_backward = v_21
        raise @rt.Lab0
      }
      e.bra = e.cursor
      @rt.slice_del(e)
      e.limit_backward = v_21
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_14
  v_22 = e.limit - e.cursor
  try {
    v_23 = e.limit - e.cursor
    try {
      e.ket = e.cursor
      if !@rt.in_grouping_b(e, g_AEIO) {
        e.cursor = e.limit - v_23
        raise @rt.Lab1
      }
      e.bra = e.cursor
      if i_pV > e.cursor {
        e.cursor = e.limit - v_23
        raise @rt.Lab1
      }
      @rt.slice_del(e)
      e.ket = e.cursor
      if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'i' {
        e.cursor = e.limit - v_23
        raise @rt.Lab1
      }
      e.cursor -= 1
      e.bra = e.cursor
      if i_pV > e.cursor {
        e.cursor = e.limit - v_23
        raise @rt.Lab1
      }
      @rt.slice_del(e)
    } catch {
      @rt.Lab1 => ()
      err => raise err
    }
    v_24 = e.limit - e.cursor
    try {
      e.ket = e.cursor
      if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'h' {
        e.cursor = e.limit - v_24
        raise @rt.Lab1
      }
      e.cursor -= 1
      e.bra = e.cursor
      if !@rt.in_grouping_b(e, g_CG) {
        e.cursor = e.limit - v_24
        raise @rt.Lab1
      }
      if i_pV > e.cursor {
        e.cursor = e.limit - v_24
        raise @rt.Lab1
      }
      @rt.slice_del(e)
    } catch {
      @rt.Lab1 => ()
      err => raise err
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_22
  e.cursor = e.limit_backward
  v_25 = e.cursor
  try {
    while true {
      v_26 = e.cursor
      try {
        e.bra = e.cursor
        among_var = @rt.find_among(e, a_2)
        e.ket = e.cursor
        if among_var == 1 {
          @rt.slice_from(e, "i")
        } else if among_var == 2 {
          @rt.slice_from(e, "u")
        } else {
          if e.cursor >= e.limit {
            raise @rt.Lab1
          }
          e.cursor += 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = v_26
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_25
  return true
}

///|
pub fn to_utf8_koi8r(bytes : Bytes) -> String raise CharsetError {
  let sb = StringBuilder()
  for i in 0..<bytes.length() {
    let b = bytes[i].to_int()
    let cp = if b < 0x80 {
      b
    } else if koi8r_table[b] >= 0 {
      koi8r_table[b]
    } else {
      raise CharsetError("unmapped byte 0x" + b.to_string(radix=16))
    }
    sb.write_char(cp.unsafe_to_char())
  }
  sb.to_string()
}

///|
pub fn to_utf8_iso8859_2(bytes : Bytes) -> String raise CharsetError {
  let sb = StringBuilder()
  for i in 0..<bytes.length() {
    let b = bytes[i].to_int()
    let cp = if b < 0x80 {
      b
    } else if iso8859_2_table[b] >= 0 {
      iso8859_2_table[b]
    } else {
      raise CharsetError("unmapped byte 0x" + b.to_string(radix=16))
    }
    sb.write_char(cp.unsafe_to_char())
  }
  sb.to_string()
}

///|
pub fn to_utf8_iso8859_1(bytes : Bytes) -> String {
  let sb = StringBuilder()
  for i in 0..<bytes.length() {
    sb.write_char(bytes[i].to_int().unsafe_to_char())
  }
  sb.to_string()
}

///|
pub fn to_utf8_cp1256(bytes : Bytes) -> String raise CharsetError {
  let sb = StringBuilder()
  for i in 0..<bytes.length() {
    let b = bytes[i].to_int()
    let cp = if b < 0x80 {
      b
    } else if cp1256_table[b] >= 0 {
      cp1256_table[b]
    } else {
      raise CharsetError("unmapped byte 0x" + b.to_string(radix=16))
    }
    sb.write_char(cp.unsafe_to_char())
  }
  sb.to_string()
}

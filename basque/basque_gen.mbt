      if !@rt.out_grouping(e, g_v) {
        raise @rt.Lab0
      }
      while true {
        v_4 = e.cursor
        try {
          if !@rt.out_grouping(e, g_v) {
            raise @rt.Lab1
          }
          if !@rt.go_out_grouping(e, g_v) {
            raise @rt.Lab1
          }
          e.cursor += 1
          break
        } catch {
          @rt.Lab1 => ()
          err => raise err
        }
        e.cursor = v_4
        if !@rt.in_grouping(e, g_v) {
          raise @rt.Lab0
        }
        if e.cursor >= e.limit {
          raise @rt.Lab0
        }
        e.cursor += 1
        break
      }
      break
    }
    p.i_pV = e.cursor
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_1
  v_5 = e.cursor
  try {
    if !@rt.go_out_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    if !@rt.go_in_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.i_p1 = e.cursor
    if !@rt.go_out_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    if !@rt.go_in_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.i_p2 = e.cursor
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_5
  return true
}

///|
fn r_RV(p : Basque) -> Bool {
  let e = p.e
  return p.i_pV <= e.cursor
}

///|
fn r_R2(p : Basque) -> Bool {
  let e = p.e
  return p.i_p2 <= e.cursor
}

///|
fn r_aditzak(p : Basque) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_0)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    if !r_RV(p) {
      return false
    }
    @rt.slice_del(e)
  } else if among_var == 2 {
    if !r_R2(p) {
      return false
    }
    @rt.slice_del(e)
  }
  return true
}

///|
fn r_izenak(p : Basque) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_1)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    if !r_RV(p) {
      return false
    }
    @rt.slice_del(e)
  } else if among_var == 2 {
    if !r_R2(p) {
      return false
    }
    @rt.slice_del(e)
  } else if among_var == 3 {
    @rt.slice_from(e, "jok")
  } else if among_var == 4 {
    if p.i_p1 > e.cursor {
      return false
    }
    @rt.slice_del(e)
  } else if among_var == 5 {
    @rt.slice_from(e, "tra")
  } else if among_var == 6 {
    @rt.slice_from(e, "minutu")
  }
  return true
}

///|
fn r_adjetiboak(p : Basque) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_2)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    if !r_RV(p) {
      return false
    }
    @rt.slice_del(e)
  } else {
    @rt.slice_from(e, "z")
  }
  return true
}

///|
fn stem_inner(p : Basque) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_3 : Int32 = 0
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let _ = r_mark_regions(p)
  e.limit_backward = e.cursor
  e.cursor = e.limit
  while true {
    v_1 = e.limit - e.cursor
    try {
      if !r_aditzak(p) {
        raise @rt.Lab0
      }
      continue
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_1
    break
  }
  while true {
    v_2 = e.limit - e.cursor
    try {
      if !r_izenak(p) {
        raise @rt.Lab0
      }
      continue
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_2
    break
  }
  v_3 = e.limit - e.cursor
  let _ = r_adjetiboak(p)
  e.cursor = e.limit - v_3
  e.cursor = e.limit_backward
  return true
}

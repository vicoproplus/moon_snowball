///|
fn r_tolower(p : Greek) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut among_var : Int32 = 0
  while true {
    v_1 = e.limit - e.cursor
    try {
      e.ket = e.cursor
      among_var = @rt.find_among_b(e, a_0)
      e.bra = e.cursor
      if among_var == 1 {
        @rt.slice_from(e, "α")
      } else if among_var == 2 {
        @rt.slice_from(e, "β")
      } else if among_var == 3 {
        @rt.slice_from(e, "γ")
      } else if among_var == 4 {
        @rt.slice_from(e, "δ")
      } else if among_var == 5 {
        @rt.slice_from(e, "ε")
      } else if among_var == 6 {
        @rt.slice_from(e, "ζ")
      } else if among_var == 7 {
        @rt.slice_from(e, "η")
      } else if among_var == 8 {
        @rt.slice_from(e, "θ")
      } else if among_var == 9 {
        @rt.slice_from(e, "ι")
      } else if among_var == 10 {
        @rt.slice_from(e, "κ")
      } else if among_var == 11 {
        @rt.slice_from(e, "λ")
      } else if among_var == 12 {
        @rt.slice_from(e, "μ")
      } else if among_var == 13 {
        @rt.slice_from(e, "ν")
      } else if among_var == 14 {
        @rt.slice_from(e, "ξ")
      } else if among_var == 15 {
        @rt.slice_from(e, "ο")
      } else if among_var == 16 {
        @rt.slice_from(e, "π")
      } else if among_var == 17 {
        @rt.slice_from(e, "ρ")
      } else if among_var == 18 {
        @rt.slice_from(e, "σ")
      } else if among_var == 19 {
        @rt.slice_from(e, "τ")
      } else if among_var == 20 {
        @rt.slice_from(e, "υ")
      } else if among_var == 21 {
        @rt.slice_from(e, "φ")
      } else if among_var == 22 {
        @rt.slice_from(e, "χ")
      } else if among_var == 23 {
        @rt.slice_from(e, "ψ")
      } else if among_var == 24 {
        @rt.slice_from(e, "ω")
      } else {
        if e.cursor <= e.limit_backward {
          raise @rt.Lab0
        }
        e.cursor -= 1
      }
      continue
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_1
    break
  }
  return true
}

///|
fn r_step_1(p : Greek) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_1)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  @rt.slice_from(e, as_1[among_var - 1])
  p.b_test1 = false
  return true
}


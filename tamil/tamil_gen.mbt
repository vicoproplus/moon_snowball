fn r_remove_pronoun_prefixes(p : Tamil) -> Bool {
  let e = p.e
  let mut v_1 : Int32 = 0
  e.bra = e.cursor
  if @rt.find_among(e, a_10) == 0 {
    return false
  }
  if @rt.find_among(e, a_11) == 0 {
    return false
  }
  if e.cursor == e.limit || e.current[e.cursor] != '்' {
    return false
  }
  e.cursor += 1
  e.ket = e.cursor
  @rt.slice_del(e)
  v_1 = e.cursor
  let _ = r_fix_va_start(p)
  e.cursor = v_1
  return true
}

///|
fn r_remove_plural_suffix(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut among_var : Int32 = 0
  let mut v_1 : Int32 = 0
  e.limit_backward = e.cursor
  e.cursor = e.limit
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_13)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    while true {
      v_1 = e.limit - e.cursor
      try {
        if @rt.find_among_b(e, a_12) == 0 {
          raise @rt.Lab0
        }
        @rt.slice_from(e, "ுங்")
        break
      } catch {
        @rt.Lab0 => ()
        err => raise err
      }
      e.cursor = e.limit - v_1
      @rt.slice_from(e, "்")
      break
    }
  } else if among_var == 2 {
    @rt.slice_from(e, "ல்")
  } else if among_var == 3 {
    @rt.slice_from(e, "ள்")
  } else {
    @rt.slice_del(e)
  }
  e.cursor = e.limit_backward
  return true
}

///|
fn r_remove_question_suffixes(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  if !r_has_min_length(p) {
    return false
  }
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_1 = e.limit - e.cursor
  try {
    e.ket = e.cursor
    if @rt.find_among_b(e, a_14) == 0 {
      raise @rt.Lab0
    }
    e.bra = e.cursor
    @rt.slice_from(e, "்")
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_1
  e.cursor = e.limit_backward
  let _ = r_fix_endings(p)
  return true
}


///|
fn r_remove_um(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  if !r_has_min_length(p) {
    return false
  }
  e.limit_backward = e.cursor
  e.cursor = e.limit
  e.ket = e.cursor
  if !@rt.eq_s_b(e, "ும்") {

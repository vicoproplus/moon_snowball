///|
fn r_remove_common_word_endings(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut among_var : Int32 = 0
  let mut v_1 : Int32 = 0
  if !r_has_min_length(p) {
    return false
  }
  e.limit_backward = e.cursor
  e.cursor = e.limit
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_17)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  if among_var == 1 {
    @rt.slice_from(e, "்")
  } else if among_var == 2 {
    v_1 = e.limit - e.cursor
    try {
      if @rt.find_among_b(e, a_16) == 0 {
        raise @rt.Lab0
      }
      return false
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_1
    @rt.slice_from(e, "்")
  } else {
    @rt.slice_del(e)
  }
  e.cursor = e.limit_backward
  let _ = r_fix_endings(p)
  return true
}

///|
fn r_remove_vetrumai_urupukal(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_9 : Int32 = 0
  let mut v_1 : Int32 = 0
  let mut v_5 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  let mut v_6 : Int32 = 0
  let mut v_8 : Int32 = 0
  let mut v_7 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  p.b_found_vetrumai_urupu = false
  if !r_has_min_length(p) {
    return false
  }
  e.limit_backward = e.cursor
  e.cursor = e.limit
  while true {
    v_1 = e.limit - e.cursor
    try {
      v_2 = e.limit - e.cursor
      e.ket = e.cursor
      among_var = @rt.find_among_b(e, a_20)
      if among_var == 0 {
        raise @rt.Lab0
      }
      e.bra = e.cursor
      if among_var == 1 {
        @rt.slice_del(e)
      } else if among_var == 2 {
        @rt.slice_from(e, "்")
      } else if among_var == 3 {
        try {
          if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'ம' {
            raise @rt.Lab1
          }
          e.cursor -= 1
          raise @rt.Lab0
        } catch {
          @rt.Lab1 => ()
          err => raise err
        }
        @rt.slice_from(e, "்")
      } else if among_var == 4 {
        if e.current.length() < 7 {
          raise @rt.Lab0
        }
        @rt.slice_from(e, "்")
      } else if among_var == 5 {
        v_3 = e.limit - e.cursor
        try {
          if @rt.find_among_b(e, a_18) == 0 {
            raise @rt.Lab1
          }
          raise @rt.Lab0
        } catch {
          @rt.Lab1 => ()
          err => raise err
        }
        e.cursor = e.limit - v_3
        @rt.slice_from(e, "்")
      } else if among_var == 6 {
        v_4 = e.limit - e.cursor
        try {
          if @rt.find_among_b(e, a_19) == 0 {
            raise @rt.Lab1
          }
          raise @rt.Lab0
        } catch {
          @rt.Lab1 => ()
          err => raise err
        }
        e.cursor = e.limit - v_4
        @rt.slice_del(e)
      } else {
        @rt.slice_from(e, "ி")
      }
      e.cursor = e.limit - v_2
      break
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_1
    v_5 = e.limit - e.cursor
    e.ket = e.cursor
    if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'ை' {
      return false
    }
    e.cursor -= 1
    while true {
      v_6 = e.limit - e.cursor
      try {
        v_7 = e.limit - e.cursor
        try {
          if @rt.find_among_b(e, a_21) == 0 {
            raise @rt.Lab1
          }
          raise @rt.Lab0
        } catch {
          @rt.Lab1 => ()
          err => raise err
        }
        e.cursor = e.limit - v_7
        break
      } catch {
        @rt.Lab0 => ()
        err => raise err
      }
      e.cursor = e.limit - v_6
      v_8 = e.limit - e.cursor
      if @rt.find_among_b(e, a_22) == 0 {
        return false
      }
      if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != '்' {
        return false
      }
      e.cursor -= 1
      e.cursor = e.limit - v_8
      break
    }
    e.bra = e.cursor
    @rt.slice_from(e, "்")
    e.cursor = e.limit - v_5
    break
  }
  p.b_found_vetrumai_urupu = true
  v_9 = e.limit - e.cursor
  try {
    e.ket = e.cursor
    if !@rt.eq_s_b(e, "ின்") {
      raise @rt.Lab0
    }
    e.bra = e.cursor
    @rt.slice_from(e, "்")
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_9
  e.cursor = e.limit_backward
  let _ = r_fix_endings(p)
  return true
}

///|
fn r_remove_tense_suffixes(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  while true {
    v_1 = e.cursor
    try {
      if !r_remove_tense_suffix(p) {
        raise @rt.Lab0
      }
      continue
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = v_1
    break
  }
  return true
}

///|
fn r_remove_tense_suffix(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut b_found_a_match : Bool = false
  let mut v_1 : Int32 = 0
  let mut v_6 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_5 : Int32 = 0
  b_found_a_match = false
  if !r_has_min_length(p) {
    return false
  }
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_1 = e.limit - e.cursor
  try {
    v_2 = e.limit - e.cursor
    e.ket = e.cursor
    among_var = @rt.find_among_b(e, a_25)
    if among_var == 0 {
      raise @rt.Lab0
    }
    e.bra = e.cursor
    if among_var == 1 {
      @rt.slice_del(e)
    } else if among_var == 2 {
      v_3 = e.limit - e.cursor
      try {
        if @rt.find_among_b(e, a_23) == 0 {
          raise @rt.Lab1
        }
        raise @rt.Lab0
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_3
      @rt.slice_del(e)
    } else if among_var == 3 {
      v_4 = e.limit - e.cursor
      try {
        if @rt.find_among_b(e, a_24) == 0 {
          raise @rt.Lab1
        }
        raise @rt.Lab0
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_4
      @rt.slice_del(e)
    } else if among_var == 4 {
      try {
        if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'ச' {
          raise @rt.Lab1
        }
        e.cursor -= 1
        raise @rt.Lab0
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      @rt.slice_from(e, "்")
    } else if among_var == 5 {
      @rt.slice_from(e, "்")
    } else {
      v_5 = e.limit - e.cursor
      if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != '்' {
        raise @rt.Lab0
      }
      e.cursor -= 1
      e.cursor = e.limit - v_5
      @rt.slice_del(e)
    }
    b_found_a_match = true
    e.cursor = e.limit - v_2
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_1
  v_6 = e.limit - e.cursor
  try {
    e.ket = e.cursor
    if @rt.find_among_b(e, a_26) == 0 {
      raise @rt.Lab0
    }
    e.bra = e.cursor
    @rt.slice_del(e)
    b_found_a_match = true
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_6
  e.cursor = e.limit_backward
  let _ = r_fix_endings(p)
  return b_found_a_match
}

///|
fn stem_inner(p : Tamil) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_5 : Int32 = 0
  let mut v_6 : Int32 = 0
  let mut v_7 : Int32 = 0
  let mut v_8 : Int32 = 0
  let mut v_9 : Int32 = 0
  p.b_found_vetrumai_urupu = false
  v_1 = e.cursor
  let _ = r_fix_ending(p)
  e.cursor = v_1
  if !r_has_min_length(p) {
    return false
  }
  v_2 = e.cursor
  let _ = r_remove_question_prefixes(p)
  e.cursor = v_2
  v_3 = e.cursor
  let _ = r_remove_pronoun_prefixes(p)
  e.cursor = v_3
  let _ = r_remove_question_suffixes(p)
  v_4 = e.cursor
  let _ = r_remove_um(p)
  e.cursor = v_4
  v_5 = e.cursor
  let _ = r_remove_common_word_endings(p)
  e.cursor = v_5
  v_6 = e.cursor
  let _ = r_remove_vetrumai_urupukal(p)
  e.cursor = v_6
  v_7 = e.cursor
  let _ = r_remove_plural_suffix(p)
  e.cursor = v_7
  v_8 = e.cursor
  let _ = r_remove_command_suffixes(p)
  e.cursor = v_8
  v_9 = e.cursor
  let _ = r_remove_tense_suffixes(p)
  e.cursor = v_9
  return true
}

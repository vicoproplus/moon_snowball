      if !r_LONGV(p) {
        raise @rt.Lab0
      }
      return false
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_5
    @rt.slice_del(e)
  } else {
    if !@rt.in_grouping_b(e, g_KI) {
      return false
    }
    @rt.slice_del(e)
  }
  return true
}

///|
fn r_verb(p : Estonian) -> Bool {
  let e = p.e
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_1)
  if among_var == 0 {
    e.limit_backward = v_2
    return false
  }
  e.bra = e.cursor
  e.limit_backward = v_2
  if among_var == 1 {
    @rt.slice_del(e)
  } else if among_var == 2 {
    @rt.slice_from(e, "a")
  } else {
    if !@rt.in_grouping_b(e, g_V1) {
      return false
    }
    @rt.slice_del(e)
  }
  return true
}

///|
fn r_LONGV(p : Estonian) -> Bool {
  let e = p.e
  return @rt.find_among_b(e, a_2) != 0
}

///|
fn r_i_plural(p : Estonian) -> Bool {
  let e = p.e
  let mut v_2 : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'i' {
    e.limit_backward = v_2
    return false
  }
  e.cursor -= 1
  e.bra = e.cursor
  e.limit_backward = v_2
  if !@rt.in_grouping_b(e, g_RV) {
    return false
  }
  @rt.slice_del(e)
  return true
}

///|
fn r_special_noun_endings(p : Estonian) -> Bool {
  let e = p.e
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_3)
  if among_var == 0 {
    e.limit_backward = v_2
    return false
  }
  e.bra = e.cursor
  e.limit_backward = v_2
  @rt.slice_from(e, as_3[among_var - 1])
  return true
}

///|
fn r_case_ending(p : Estonian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  let mut v_3 : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_4)
  if among_var == 0 {
    e.limit_backward = v_2
    return false
  }
  e.bra = e.cursor
  e.limit_backward = v_2
  if among_var == 1 {
    while true {
      try {
        if !@rt.in_grouping_b(e, g_RV) {
          raise @rt.Lab0
        }
        break
      } catch {
        @rt.Lab0 => ()
        err => raise err
      }
      if !r_LONGV(p) {
        return false
      }
      break
    }
  } else {
    v_3 = e.limit - e.cursor
    if e.cursor - 4 < e.limit_backward {
      return false
    }
    e.cursor -= 4
    e.cursor = e.limit - v_3
  }
  @rt.slice_del(e)
  return true
}

///|
fn r_plural_three_first_cases(p : Estonian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_5 : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_6)
  if among_var == 0 {
    e.limit_backward = v_2
    return false
  }
  e.bra = e.cursor
  e.limit_backward = v_2
  if among_var == 1 {
    @rt.slice_from(e, "iku")
  } else if among_var == 2 {
    v_3 = e.limit - e.cursor
    try {
      if !r_LONGV(p) {
        raise @rt.Lab0
      }
      return false
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    e.cursor = e.limit - v_3
    @rt.slice_del(e)
  } else if among_var == 3 {
    while true {
      v_4 = e.limit - e.cursor
      try {
        v_5 = e.limit - e.cursor
        if e.cursor - 4 < e.limit_backward {
          raise @rt.Lab0
        }
        e.cursor -= 4
        e.cursor = e.limit - v_5
        among_var = @rt.find_among_b(e, a_5)
        if among_var > 0 {
          @rt.slice_from(e, as_5[among_var - 1])
        }
        break
      } catch {
        @rt.Lab0 => ()
        err => raise err
      }
      e.cursor = e.limit - v_4
      @rt.slice_from(e, "t")
      break
    }
  } else {
    while true {
      try {
        if !@rt.in_grouping_b(e, g_RV) {
          raise @rt.Lab0
        }
        break
      } catch {
        @rt.Lab0 => ()
        err => raise err
      }
      if !r_LONGV(p) {
        return false
      }
      break
    }
    @rt.slice_del(e)
  }
  return true
}

///|
fn r_nu(p : Estonian) -> Bool {
  let e = p.e
  let mut v_2 : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  if @rt.find_among_b(e, a_7) == 0 {
    e.limit_backward = v_2
    return false
  }
  e.bra = e.cursor
  e.limit_backward = v_2
  @rt.slice_del(e)
  return true
}

///|
fn r_undouble_kpt(p : Estonian) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  if !@rt.in_grouping_b(e, g_V1) {
    return false
  }
  if p.i_p1 > e.cursor {
    return false
  }
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_8)
  if among_var == 0 {
    return false
  }
  e.bra = e.cursor
  @rt.slice_from(e, as_8[among_var - 1])
  return true
}

///|
fn r_degrees(p : Estonian) -> Bool {
  let e = p.e
  let mut v_2 : Int32 = 0
  let mut among_var : Int32 = 0
  if e.cursor < p.i_p1 {
    return false
  }
  v_2 = e.limit_backward
  e.limit_backward = p.i_p1
  e.ket = e.cursor
  among_var = @rt.find_among_b(e, a_9)
  if among_var == 0 {
    e.limit_backward = v_2
    return false
  }
  e.bra = e.cursor
  e.limit_backward = v_2
  if among_var == 1 {
    if !@rt.in_grouping_b(e, g_RV) {
      return false
    }
    @rt.slice_del(e)
  } else {
    @rt.slice_del(e)
  }
  return true
}

///|
fn r_substantive(p : Estonian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_5 : Int32 = 0
  let mut v_6 : Int32 = 0
  v_1 = e.limit - e.cursor
  let _ = r_special_noun_endings(p)
  e.cursor = e.limit - v_1
  v_2 = e.limit - e.cursor
  let _ = r_case_ending(p)
  e.cursor = e.limit - v_2
  v_3 = e.limit - e.cursor
  let _ = r_plural_three_first_cases(p)
  e.cursor = e.limit - v_3
  v_4 = e.limit - e.cursor
  let _ = r_degrees(p)
  e.cursor = e.limit - v_4
  v_5 = e.limit - e.cursor
  let _ = r_i_plural(p)
  e.cursor = e.limit - v_5
  v_6 = e.limit - e.cursor
  let _ = r_nu(p)
  e.cursor = e.limit - v_6
  return true
}

///|
fn r_verb_exceptions(p : Estonian) -> Bool {
  let e = p.e
  let mut among_var : Int32 = 0
  e.bra = e.cursor
  among_var = @rt.find_among(e, a_10)
  if among_var == 0 {
    return false
  }
  e.ket = e.cursor
  if e.cursor < e.limit {
    return false
  }
  @rt.slice_from(e, as_10[among_var - 1])
  return true
}

///|
fn stem_inner(p : Estonian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_6 : Int32 = 0
  let mut v_5 : Int32 = 0
  v_1 = e.cursor
  try {
    if !r_verb_exceptions(p) {
      raise @rt.Lab0
    }
    return false
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_1
  v_2 = e.cursor
  let _ = r_mark_regions(p)
  e.cursor = v_2
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_3 = e.limit - e.cursor
  let _ = r_emphasis(p)
  e.cursor = e.limit - v_3
  v_4 = e.limit - e.cursor
  try {
    while true {
      v_5 = e.limit - e.cursor
      try {
        if !r_verb(p) {
          raise @rt.Lab1
        }
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_5
      let _ = r_substantive(p)
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_4
  v_6 = e.limit - e.cursor
  let _ = r_undouble_kpt(p)
  e.cursor = e.limit - v_6
  e.ket = e.cursor
  if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != '\'' {
    return false
  }
  e.cursor -= 1
  e.bra = e.cursor
  @rt.slice_del(e)
  e.cursor = e.limit_backward
  return true
}

  @rt.Among::new("ost", -1, 1),
  @rt.Among::new("u", -1, 1),
  @rt.Among::new("enu", 24, 1),
]

///|
fn r_cyr_to_lat(p : Serbian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut among_var : Int32 = 0
  v_1 = e.cursor
  try {
    while true {
      v_2 = e.cursor
      try {
        while true {
          v_3 = e.cursor
          try {
            e.bra = e.cursor
            among_var = @rt.find_among(e, a_0)
            if among_var == 0 {
              raise @rt.Lab2
            }
            e.ket = e.cursor
            @rt.slice_from(e, as_0[among_var - 1])
            e.cursor = v_3
            break
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
          e.cursor = v_3
          if e.cursor >= e.limit {
            raise @rt.Lab1
          }
          e.cursor += 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = v_2
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_1
  return true
}

///|
fn r_prelude(p : Serbian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_7 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_5 : Int32 = 0
  let mut v_8 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_6 : Int32 = 0
  let mut v_9 : Int32 = 0
  v_1 = e.cursor
  try {
    while true {
      v_2 = e.cursor
      try {
        while true {
          v_3 = e.cursor
          try {
            if !@rt.in_grouping(e, g_ca) {
              raise @rt.Lab2
            }
            e.bra = e.cursor
            if !@rt.eq_s(e, "ije") {
              raise @rt.Lab2
            }
            e.ket = e.cursor
            if !@rt.in_grouping(e, g_ca) {
              raise @rt.Lab2
            }
            @rt.slice_from(e, "e")
            e.cursor = v_3
            break
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
          e.cursor = v_3
          if e.cursor >= e.limit {
            raise @rt.Lab1
          }
          e.cursor += 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = v_2
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_1
  v_4 = e.cursor
  try {
    while true {
      v_5 = e.cursor
      try {
        while true {
          v_6 = e.cursor
          try {
            if !@rt.in_grouping(e, g_ca) {
              raise @rt.Lab2
            }
            e.bra = e.cursor
            if !@rt.eq_s(e, "je") {
              raise @rt.Lab2
            }
            e.ket = e.cursor
            if !@rt.in_grouping(e, g_ca) {
              raise @rt.Lab2
            }
            @rt.slice_from(e, "e")
            e.cursor = v_6
            break
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
          e.cursor = v_6
          if e.cursor >= e.limit {
            raise @rt.Lab1
          }
          e.cursor += 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = v_5
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_4
  v_7 = e.cursor
  try {
    while true {
      v_8 = e.cursor
      try {
        while true {
          v_9 = e.cursor
          try {
            e.bra = e.cursor
            if !@rt.eq_s(e, "dj") {
              raise @rt.Lab2
            }
            e.ket = e.cursor
            @rt.slice_from(e, "đ")
            e.cursor = v_9
            break
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
          e.cursor = v_9
          if e.cursor >= e.limit {
            raise @rt.Lab1
          }
          e.cursor += 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = v_8
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_7
  return true
}

///|
fn r_mark_regions(p : Serbian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  p.b_no_diacritics = true
  v_1 = e.cursor
  try {
    if !@rt.go_out_grouping(e, g_sa) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.b_no_diacritics = false
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_1
  p.i_p1 = e.limit
  v_2 = e.cursor
  try {
    if !@rt.go_out_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.i_p1 = e.cursor
    if p.i_p1 >= 2 {
      raise @rt.Lab0
    }
    if !@rt.go_in_grouping(e, g_v) {
      raise @rt.Lab0
    }
    e.cursor += 1
    p.i_p1 = e.cursor
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_2
  v_3 = e.cursor
  try {
    while true {
      try {
        if e.cursor == e.limit || e.current[e.cursor] != 'r' {
          raise @rt.Lab1
        }
        e.cursor += 1
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      if e.cursor >= e.limit {
        raise @rt.Lab0
      }
      e.cursor += 1
    }
    while true {
      try {
        if e.cursor < 2 {
          raise @rt.Lab1
        }
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      if !@rt.go_in_grouping(e, g_rg) {
        raise @rt.Lab0
      }
      e.cursor += 1
      break
    }
    if p.i_p1 - e.cursor <= 1 {
      raise @rt.Lab0
    }
    p.i_p1 = e.cursor
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_3
  return true
}

///|
fn r_R1(p : Serbian) -> Bool {
  let e = p.e
  return p.i_p1 <= e.cursor
}


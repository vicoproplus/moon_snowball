///|
fn r_Step_3(p : Serbian) -> Bool {
  let e = p.e
  e.ket = e.cursor
  if @rt.find_among_b(e, a_3) == 0 {
    return false
  }
  e.bra = e.cursor
  if !r_R1(p) {
    return false
  }
  @rt.slice_del(e)
  return true
}

///|
fn stem_inner(p : Serbian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  let _ = r_cyr_to_lat(p)
  let _ = r_prelude(p)
  let _ = r_mark_regions(p)
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_1 = e.limit - e.cursor
  let _ = r_Step_1(p)
  e.cursor = e.limit - v_1
  v_2 = e.limit - e.cursor
  try {
    while true {
      v_3 = e.limit - e.cursor
      try {
        if !r_Step_2(p) {
          raise @rt.Lab1
        }
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_3
      if !r_Step_3(p) {
        raise @rt.Lab0
      }
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_2
  e.cursor = e.limit_backward
  return true
}

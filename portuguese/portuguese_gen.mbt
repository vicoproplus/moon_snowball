          @rt.slice_from(e, "ã")
        } else if among_var == 2 {
          @rt.slice_from(e, "õ")
        } else {
          if e.cursor >= e.limit {
            raise @rt.Lab1
          }
          e.cursor += 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = v_25
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = v_24
  return true
}


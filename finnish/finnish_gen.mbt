  let mut v_6 : Int32 = 0
  v_1 = e.cursor
  let _ = r_mark_regions(p)
  e.cursor = v_1
  p.b_ending_removed = false
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_2 = e.limit - e.cursor
  let _ = r_particle_etc(p)
  e.cursor = e.limit - v_2
  v_3 = e.limit - e.cursor
  let _ = r_possessive(p)
  e.cursor = e.limit - v_3
  v_4 = e.limit - e.cursor
  let _ = r_case_ending(p)
  e.cursor = e.limit - v_4
  v_5 = e.limit - e.cursor
  let _ = r_other_endings(p)
  e.cursor = e.limit - v_5
  while true {
    try {
      if !p.b_ending_removed {
        raise @rt.Lab0
      }
      v_6 = e.limit - e.cursor
      let _ = r_i_plural(p)
      e.cursor = e.limit - v_6
      break
    } catch {
      @rt.Lab0 => ()
      err => raise err
    }
    v_7 = e.limit - e.cursor
    let _ = r_t_plural(p)
    e.cursor = e.limit - v_7
    break
  }
  v_8 = e.limit - e.cursor
  let _ = r_tidy(p)
  e.cursor = e.limit - v_8
  e.cursor = e.limit_backward
  return true
}

///|
fn among_a_7(p : Finnish) -> Int32 raise @rt.Lab {
  let e = p.e
  let c0 = e.cursor
  let mut r = @rt.find_among_bwd_id(e, a_7)
  while r >= 1000000 {
    let at = r - 1000000
    let ok = match a_7[at].routine_id {
      1 => r_A(p)
      8 => r_A_(p)
      4 => r_E(p)
      5 => r_I(p)
      3 => r_LV(p)
      6 => r_O(p)
      9 => r_O_(p)
      7 => r_U(p)
      2 => r_VI(p)
      _ => false
    }
    if ok {
      e.cursor = c0 - a_7[at].s.length()
      return a_7[at].result
    }
    r = @rt.find_among_resume_bwd(e, a_7, c0, at)
  }
  r
}

      }
      if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'u' {
        e.limit_backward = v_2
        return false
      }
      e.cursor -= 1
      break
    }
    @rt.slice_del(e)
  } else {
    @rt.slice_del(e)
  }
  e.limit_backward = v_2
  return true
}

///|
fn r_vowel_suffix(p : Romanian) -> Bool {
  let e = p.e
  e.ket = e.cursor
  if @rt.find_among_b(e, a_6) == 0 {
    return false
  }
  e.bra = e.cursor
  if p.i_pV > e.cursor {
    return false
  }
  @rt.slice_del(e)
  return true
}

///|
fn stem_inner(p : Romanian) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let mut v_2 : Int32 = 0
  let mut v_3 : Int32 = 0
  let mut v_4 : Int32 = 0
  let mut v_5 : Int32 = 0
  let mut v_6 : Int32 = 0
  let _ = r_norm(p)
  v_1 = e.cursor
  let _ = r_prelude(p)
  e.cursor = v_1
  let _ = r_mark_regions(p)
  e.limit_backward = e.cursor
  e.cursor = e.limit
  v_2 = e.limit - e.cursor
  let _ = r_step_0(p)
  e.cursor = e.limit - v_2
  v_3 = e.limit - e.cursor
  let _ = r_standard_suffix(p)
  e.cursor = e.limit - v_3
  v_4 = e.limit - e.cursor
  try {
    while true {
      try {
        if !p.b_standard_suffix_removed {
          raise @rt.Lab1
        }
        break
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      if !r_verb_suffix(p) {
        raise @rt.Lab0
      }
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_4
  v_5 = e.limit - e.cursor
  let _ = r_vowel_suffix(p)
  e.cursor = e.limit - v_5
  e.cursor = e.limit_backward
  v_6 = e.cursor
  let _ = r_postlude(p)
  e.cursor = v_6
  return true
}

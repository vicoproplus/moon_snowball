    } else if among_var == 15 {
      @rt.slice_from(e, "רײב")
    } else if among_var == 16 {
      @rt.slice_from(e, "רײס")
    } else if among_var == 17 {
      @rt.slice_from(e, "שװײג")
    } else if among_var == 18 {
      @rt.slice_from(e, "שמײס")
    } else if among_var == 19 {
      @rt.slice_from(e, "שנײד")
    } else if among_var == 20 {
      @rt.slice_from(e, "בינד")
    } else if among_var == 21 {
      @rt.slice_from(e, "װיטש")
    } else if among_var == 22 {
      @rt.slice_from(e, "זינג")
    } else if among_var == 23 {
      @rt.slice_from(e, "טרינק")
    } else if among_var == 24 {
      @rt.slice_from(e, "צװינג")
    } else if among_var == 25 {
      @rt.slice_from(e, "שלינג")
    } else if among_var == 26 {
      @rt.slice_from(e, "בײג")
    } else if among_var == 27 {
      @rt.slice_from(e, "הײב")
    } else if among_var == 28 {
      @rt.slice_from(e, "פארליר")
    } else if among_var == 29 {
      @rt.slice_from(e, "שטײ")
    } else if among_var == 30 {
      @rt.slice_from(e, "שװער")
    } else if among_var == 31 {
      @rt.slice_from(e, "ברענג")
    } else if among_var == 32 {
      if !r_R1(p) {
        raise @rt.Lab0
      }
      @rt.slice_from(e, "ה")
    } else if among_var == 33 {
      while true {
        v_4 = e.limit - e.cursor
        try {
          while true {
            try {
              if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'ג' {
                raise @rt.Lab2
              }
              e.cursor -= 1
              break
            } catch {
              @rt.Lab2 => ()
              err => raise err
            }
            if e.cursor <= e.limit_backward || e.current[e.cursor - 1] != 'ש' {
              raise @rt.Lab1
            }
            e.cursor -= 1
            break
          }
          v_5 = e.limit - e.cursor
          try {
            if p.i_p1 > e.cursor + 3 {
              e.cursor = e.limit - v_5
              raise @rt.Lab2
            }
            @rt.slice_from(e, "יס")
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
          break
        } catch {
          @rt.Lab1 => ()
          err => raise err
        }
        e.cursor = e.limit - v_4
        if !r_R1(p) {
          raise @rt.Lab0
        }
        @rt.slice_del(e)
        break
      }
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_1
  v_6 = e.limit - e.cursor
  try {
    e.ket = e.cursor
    among_var = @rt.find_among_b(e, a_5)
    if among_var == 0 {
      raise @rt.Lab0
    }
    e.bra = e.cursor
    if among_var == 1 {
      if !r_R1(p) {
        raise @rt.Lab0
      }
      @rt.slice_del(e)
    } else {
      if !r_R1(p) {
        raise @rt.Lab0
      }
      if !@rt.in_grouping_b(e, g_consonant) {
        raise @rt.Lab0
      }
      @rt.slice_del(e)
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_6
  v_7 = e.limit - e.cursor
  try {
    e.ket = e.cursor
    among_var = @rt.find_among_b(e, a_6)
    if among_var == 0 {
      raise @rt.Lab0
    }
    e.bra = e.cursor
    if among_var == 1 {
      if !r_R1(p) {
        raise @rt.Lab0
      }
      @rt.slice_del(e)
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_7
  v_8 = e.limit - e.cursor
  try {
    while true {
      v_9 = e.limit - e.cursor
      try {
        while true {
          v_10 = e.limit - e.cursor
          try {
            e.ket = e.cursor
            while true {
              try {
                if !@rt.eq_s_b(e, "GE") {
                  raise @rt.Lab3
                }
                break
              } catch {
                @rt.Lab3 => ()
                err => raise err
              }
              if !@rt.eq_s_b(e, "TSU") {
                raise @rt.Lab2
              }
              break
            }
            e.bra = e.cursor
            @rt.slice_del(e)
            e.cursor = e.limit - v_10
            break
          } catch {
            @rt.Lab2 => ()
            err => raise err
          }
          e.cursor = e.limit - v_10
          if e.cursor <= e.limit_backward {
            raise @rt.Lab1
          }
          e.cursor -= 1
        }
        continue
      } catch {
        @rt.Lab1 => ()
        err => raise err
      }
      e.cursor = e.limit - v_9
      break
    }
  } catch {
    @rt.Lab0 => ()
    err => raise err
  }
  e.cursor = e.limit - v_8
  return true
}

///|
fn stem_inner(p : Yiddish) -> Bool raise @rt.Lab {
  let e = p.e
  let mut v_1 : Int32 = 0
  let _ = r_prelude(p)
  v_1 = e.cursor
  let _ = r_mark_regions(p)
  e.cursor = v_1
  e.limit_backward = e.cursor
  e.cursor = e.limit
  let _ = r_standard_suffix(p)
  e.cursor = e.limit_backward
  return true
}
